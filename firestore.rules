rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && userDocument().data != null;
    }

    function hasRole(role) {
      return hasProfile() && userDocument().data.role == role;
    }

    function isTutorOrAdmin() {
      return hasRole('tutor') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function normalizedAuthEmail() {
      return request.auth.token.email == null
        ? ''
        : request.auth.token.email;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student';

      allow read: if signedIn();

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
        )
      );

      allow delete: if isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn()
        && ((resource.data.studentAuthUid == request.auth.uid || resource.data.userId == request.auth.uid) || isTutorOrAdmin());
      allow update: if isTutorOrAdmin();
      allow delete: if isTutorOrAdmin();
    }

    match /quizDraftAttempts/{draftId} {
      allow create, read, update, delete: if signedIn()
        && (request.resource.data.studentId == request.auth.uid
          || resource.data.studentId == request.auth.uid);
    }

    match /students/{studentId} {
      allow read: if signedIn()
        && (
          resource.data.authUid == request.auth.uid
          || (
            request.auth.token.email != null
            && resource.data.email == request.auth.token.email
          )
          || isTutorOrAdmin()
        );

      allow create, delete: if isTutorOrAdmin();

      allow update: if isTutorOrAdmin() || (
        signedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email
        && (!('authUid' in resource.data) || resource.data.authUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid',
          'emailNormalized',
          'identityLinkedAt',
          'updatedAt'
        ])
        && request.resource.data.authUid == request.auth.uid
      );
    }

    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isTutorOrAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow read: if signedIn()
        && (
          resource.data.studentAuthUid == request.auth.uid
          || (
            request.auth.token.email != null
            && resource.data.studentEmail == request.auth.token.email
          )
          || isTutorOrAdmin()
        );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow delete: if isTutorOrAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow delete: if isTutorOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.userUid == request.auth.uid;
      allow create: if signedIn();
    }


    match /feeStructures/{feeStructureId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /studentInvoices/{invoiceId} {
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || (
          request.auth.token.email != null
          && resource.data.studentEmail == request.auth.token.email
        )
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /financePayments/{paymentId} {
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || (
          request.auth.token.email != null
          && resource.data.studentEmail == request.auth.token.email
        )
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /clinicalLogbookEntries/{entryId} {
      allow create: if signedIn()
        && request.resource.data.studentAuthUid == request.auth.uid;
      allow read: if signedIn()
        && (
          resource.data.studentAuthUid == request.auth.uid
          || isTutorOrAdmin()
        );
      allow update: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clinicalSite',
          'department',
          'supervisorName',
          'courseUnitId',
          'courseUnitTitle',
          'procedureCategory',
          'procedureName',
          'procedureDate',
          'patientAgeGroup',
          'patientSex',
          'indication',
          'outcome',
          'reflection',
          'status',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow delete: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && resource.data.status == 'draft'
      );
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /timetableEntries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn()
        && (
          resource.data.studentAuthUid == request.auth.uid
          || resource.data.userId == request.auth.uid
          || (
            resource.data.studentId != null
            && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.email == request.auth.token.email
          )
          || isTutorOrAdmin()
        );

      allow create, delete: if isTutorOrAdmin();

      allow update: if isTutorOrAdmin() || (
        signedIn()
        && request.auth.token.email != null
        && resource.data.studentId != null
        && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentAuthUid',
          'userId',
          'studentEmailNormalized',
          'identityLinkedAt',
          'updatedAt'
        ])
        && request.resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
    }


    match /aiUsageLogs/{logId} {
      allow read: if isTutorOrAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if isTutorOrAdmin();
    }
  }
}
