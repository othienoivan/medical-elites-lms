rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && userDocument().data != null;
    }

    function hasRole(role) {
      return hasProfile() && userDocument().data.role == role;
    }

    function isTutorOrAdmin() {
      return hasRole('tutor') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function ownsByUid(data) {
      return signedIn() && (
        data.studentAuthUid == request.auth.uid
        || data.userId == request.auth.uid
        || data.studentId == request.auth.uid
      );
    }

    function ownsByEmail(data) {
      return signedIn()
        && request.auth.token.email != null
        && (
          data.studentEmail == request.auth.token.email
          || data.email == request.auth.token.email
          || data.emailNormalized == request.auth.token.email
          || data.studentEmailNormalized == request.auth.token.email
        );
    }

    function ownsLinkedStudent(data) {
      return signedIn()
        && data.studentId != null
        && exists(/databases/$(database)/documents/students/$(data.studentId))
        && (
          get(/databases/$(database)/documents/students/$(data.studentId)).data.authUid == request.auth.uid
          || (
            request.auth.token.email != null
            && (
              get(/databases/$(database)/documents/students/$(data.studentId)).data.email == request.auth.token.email
              || get(/databases/$(database)/documents/students/$(data.studentId)).data.emailNormalized == request.auth.token.email
            )
          )
        );
    }

    match /users/{userId} {
      // Testing-phase policy: students and tutors may self-register.
      // Before commercialization, restrict tutor creation to invitations,
      // administrator approval, or subscription entitlements.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedRole in ['student', 'tutor']
        && request.resource.data.role == request.resource.data.requestedRole
        && request.resource.data.isActive == true;

      allow read: if signedIn();

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
        )
      );

      allow delete: if isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow read: if ownsByUid(resource.data) || isTutorOrAdmin();
      allow update, delete: if isTutorOrAdmin();
    }

    match /quizDraftAttempts/{draftId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow read, update, delete: if signedIn()
        && resource.data.studentId == request.auth.uid;
    }

    match /students/{studentId} {
      allow read: if signedIn() && (
        resource.data.authUid == request.auth.uid
        || ownsByEmail(resource.data)
        || isTutorOrAdmin()
      );

      allow create, delete: if isTutorOrAdmin();

      allow update: if isTutorOrAdmin() || (
        signedIn()
        && ownsByEmail(resource.data)
        && (!('authUid' in resource.data) || resource.data.authUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid',
          'emailNormalized',
          'identityLinkedAt',
          'updatedAt'
        ])
        && request.resource.data.authUid == request.auth.uid
      );
    }

    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isTutorOrAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || ownsByEmail(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderUid',
          'updatedAt'
        ]);
      allow delete: if isTutorOrAdmin();
    }

    match /messages/{messageId} {
      function conversationData() {
        return get(
          /databases/$(database)/documents/conversations/$(resource.data.conversationId)
        ).data;
      }

      function newConversationData() {
        return get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data;
      }

      allow read: if signedIn()
        && request.auth.uid in conversationData().participantUids;

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.auth.uid in newConversationData().participantUids
        && request.resource.data.recipientUid in newConversationData().participantUids;

      allow update: if signedIn()
        && request.auth.uid in conversationData().participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readByUids'
        ]);

      allow delete: if isTutorOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.userUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && (
          request.resource.data.userUid == request.auth.uid
          || isTutorOrAdmin()
          || request.resource.data.type == 'message'
        );
    }

    match /feeStructures/{feeStructureId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /studentInvoices/{invoiceId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || ownsByEmail(resource.data)
        || ownsLinkedStudent(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /financePayments/{paymentId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || ownsByEmail(resource.data)
        || ownsLinkedStudent(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /clinicalLogbookEntries/{entryId} {
      allow create: if signedIn()
        && request.resource.data.studentAuthUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || isTutorOrAdmin()
      );
      allow update: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clinicalSite', 'department', 'supervisorName', 'courseUnitId',
          'courseUnitTitle', 'procedureCategory', 'procedureName',
          'procedureDate', 'patientAgeGroup', 'patientSex', 'indication',
          'outcome', 'reflection', 'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow delete: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && resource.data.status == 'draft'
      );
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /timetableEntries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || (
          resource.data.studentId != null
          && request.auth.token.email != null
          && (
            get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.email == request.auth.token.email
            || get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.emailNormalized == request.auth.token.email
          )
        )
        || isTutorOrAdmin()
      );

      allow create, delete: if isTutorOrAdmin();

      allow update: if isTutorOrAdmin() || (
        signedIn()
        && request.auth.token.email != null
        && resource.data.studentId != null
        && (
          get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.email == request.auth.token.email
          || get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.emailNormalized == request.auth.token.email
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentAuthUid', 'userId', 'studentEmailNormalized',
          'identityLinkedAt', 'updatedAt'
        ])
        && request.resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );
    }

    match /contactRequests/{requestId} {
      allow create: if
        request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'public-website';
      allow read, update, delete: if isAdmin();
    }

    match /aiUsageLogs/{logId} {
      allow read: if isTutorOrAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Academic catalogue and assessment definitions.
    match /programmes/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /courses/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /modules/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /lessons/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /questions/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /quizzes/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /examinations/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    // Secure default: collections not explicitly listed above are inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
