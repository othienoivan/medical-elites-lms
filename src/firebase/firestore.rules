rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && userDocument().data != null;
    }

    function hasRole(role) {
      return hasProfile() && userDocument().data.role == role;
    }

    function isTutorOrAdmin() {
      return hasRole('tutor') || hasRole('admin');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isPlatformAdmin() {
      return isAdmin()
        && userDocument().data.keys().hasAny(['platformRole'])
        && userDocument().data.platformRole in [
          'super_admin',
          'platform_support',
          'platform_finance'
        ];
    }


    function currentInstitutionId() {
      return hasProfile() && userDocument().data.keys().hasAny(['institutionId'])
        ? userDocument().data.institutionId
        : null;
    }

    function currentTenantId() {
      return hasProfile() && userDocument().data.keys().hasAny(['activeTenantId'])
        ? userDocument().data.activeTenantId
        : hasProfile() && userDocument().data.keys().hasAny(['tenantId'])
          ? userDocument().data.tenantId
          : currentInstitutionId();
    }

    function tenantMembershipId(tenantId) {
      return tenantId + '_' + request.auth.uid;
    }

    function hasTenantMembership(tenantId) {
      return signedIn()
        && tenantId is string
        && tenantId.size() > 0
        && exists(/databases/$(database)/documents/tenantMemberships/$(tenantMembershipId(tenantId)))
        && get(/databases/$(database)/documents/tenantMemberships/$(tenantMembershipId(tenantId))).data.status == 'active';
    }

    function tenantMembership(tenantId) {
      return get(/databases/$(database)/documents/tenantMemberships/$(tenantMembershipId(tenantId)));
    }

    function hasTenantRole(tenantId, role) {
      return hasTenantMembership(tenantId)
        && tenantMembership(tenantId).data.roles is list
        && role in tenantMembership(tenantId).data.roles;
    }

    function canManageTenant(tenantId) {
      return isPlatformAdmin()
        || hasTenantRole(tenantId, 'owner')
        || hasTenantRole(tenantId, 'institution_admin');
    }

    function recordInstitutionId(data) {
      return data.keys().hasAny(['institutionId']) ? data.institutionId : null;
    }

    function sameInstitution(data) {
      return signedIn()
        && recordInstitutionId(data) != null
        && currentInstitutionId() != null
        && recordInstitutionId(data) == currentInstitutionId();
    }

    function validCreateInstitution(data) {
      return currentInstitutionId() == null
        ? recordInstitutionId(data) == null
        : recordInstitutionId(data) == currentInstitutionId();
    }

    function ownsRecord(data) {
      return signedIn() && (
        (data.keys().hasAny(['ownerUserId']) && data.ownerUserId == request.auth.uid)
        || (data.keys().hasAny(['createdByUid']) && data.createdByUid == request.auth.uid)
        || (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid)
        || (data.keys().hasAny(['tutorId']) && data.tutorId == request.auth.uid)
      );
    }

    function assignedTutor(data) {
      return signedIn()
        && data.keys().hasAny(['assignedTutorIds'])
        && request.auth.uid in data.assignedTutorIds;
    }

    function canManageRecord(data) {
      return isAdmin() && sameInstitution(data) || ownsRecord(data) || assignedTutor(data);
    }

    function canonicalStudentDocument() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function hasCanonicalStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function hasProgrammeAssignment(programmeId) {
      return (
        hasProfile()
        && userDocument().data.keys().hasAny(['programmeIds'])
        && userDocument().data.programmeIds is list
        && programmeId in userDocument().data.programmeIds
      ) || (
        hasCanonicalStudent()
        && canonicalStudentDocument().data.keys().hasAny(['programmeId'])
        && canonicalStudentDocument().data.programmeId == programmeId
      );
    }

    function hasCourseUnitAssignment(courseUnitId) {
      return (
        hasProfile()
        && userDocument().data.keys().hasAny(['assignedCourseUnitIds'])
        && userDocument().data.assignedCourseUnitIds is list
        && courseUnitId in userDocument().data.assignedCourseUnitIds
      ) || (
        hasCanonicalStudent()
        && canonicalStudentDocument().data.keys().hasAny(['assignedCourseUnitIds'])
        && canonicalStudentDocument().data.assignedCourseUnitIds is list
        && courseUnitId in canonicalStudentDocument().data.assignedCourseUnitIds
      );
    }

    function hasLegacyEnrollment(courseUnitId) {
      return signedIn()
        && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseUnitId))
        && (
          !get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseUnitId)).data.keys().hasAny(['status'])
          || get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseUnitId)).data.status in ['active', 'approved', 'enrolled', 'accepted', 'completed']
        );
    }

    function canReadCourseRecord(documentId, data) {
      return hasCourseUnitAssignment(documentId)
        || hasLegacyEnrollment(documentId)
        || (
          data.keys().hasAny(['courseId'])
          && data.courseId is string
          && (
            hasCourseUnitAssignment(data.courseId)
            || hasLegacyEnrollment(data.courseId)
          )
        )
        || (
          data.keys().hasAny(['id'])
          && data.id is string
          && (
            hasCourseUnitAssignment(data.id)
            || hasLegacyEnrollment(data.id)
          )
        );
    }

    function canReadProgramme(programmeId) {
      return exists(/databases/$(database)/documents/programmes/$(programmeId))
        && (
          ownsRecord(get(/databases/$(database)/documents/programmes/$(programmeId)).data)
          || assignedTutor(get(/databases/$(database)/documents/programmes/$(programmeId)).data)
          || (isAdmin() && sameInstitution(get(/databases/$(database)/documents/programmes/$(programmeId)).data))
          || (hasRole('student') && hasProgrammeAssignment(programmeId))
        );
    }

    function ownsByUid(data) {
      return signedIn() && (
        (data.keys().hasAny(['studentAuthUid']) && data.studentAuthUid == request.auth.uid)
        || (data.keys().hasAny(['userId']) && data.userId == request.auth.uid)
        || (data.keys().hasAny(['studentId']) && data.studentId == request.auth.uid)
      );
    }

    function ownsByEmail(data) {
      return signedIn()
        && request.auth.token.email != null
        && (
          (data.keys().hasAny(['studentEmail']) && data.studentEmail == request.auth.token.email)
          || (data.keys().hasAny(['email']) && data.email == request.auth.token.email)
          || (data.keys().hasAny(['emailNormalized']) && data.emailNormalized == request.auth.token.email)
          || (data.keys().hasAny(['studentEmailNormalized']) && data.studentEmailNormalized == request.auth.token.email)
        );
    }

    function ownsLinkedStudent(data) {
      return signedIn()
        && data.keys().hasAny(['studentId'])
        && data.studentId is string
        && exists(/databases/$(database)/documents/students/$(data.studentId))
        && (
          (
            get(/databases/$(database)/documents/students/$(data.studentId)).data.keys().hasAny(['authUid'])
            && get(/databases/$(database)/documents/students/$(data.studentId)).data.authUid == request.auth.uid
          )
          || (
            request.auth.token.email != null
            && (
              (
                get(/databases/$(database)/documents/students/$(data.studentId)).data.keys().hasAny(['email'])
                && get(/databases/$(database)/documents/students/$(data.studentId)).data.email == request.auth.token.email
              )
              || (
                get(/databases/$(database)/documents/students/$(data.studentId)).data.keys().hasAny(['emailNormalized'])
                && get(/databases/$(database)/documents/students/$(data.studentId)).data.emailNormalized == request.auth.token.email
              )
            )
          )
        );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedRole in ['student', 'tutor']
        && request.resource.data.role == request.resource.data.requestedRole
        && request.resource.data.isActive == true;

      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || (hasRole('tutor') && resource.data.role == 'student' && (
          resource.data.institutionId == currentInstitutionId()
          || request.auth.uid in resource.data.linkedTutorIds
        ))
      );

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
        )
      );

      allow delete: if isAdmin();
    }


    match /analyticsSnapshots/{snapshotId} {
      allow read: if signedIn() && (
        isAdmin()
        || (resource.data.institutionId == currentInstitutionId() && hasRole('tutor'))
        || (resource.data.userId == request.auth.uid)
      );
      // Snapshots are server-maintained. Browser clients cannot create or mutate them.
      allow create, update, delete: if false;
    }

    match /quizAttempts/{attemptId} {
      // Completed attempts are created only by the trusted submitQuizAttempt
      // Cloud Function, which atomically enforces the tutor-defined limit.
      allow create: if false;
      allow read: if ownsByUid(resource.data) || isTutorOrAdmin();
      // Tutors may add manual marking and release metadata, but cannot alter
      // the learner identity, submitted answers, score or attempt sequence.
      allow update: if isTutorOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'manualMarks',
          'manualScore',
          'finalScore',
          'finalPercentage',
          'tutorRemarks',
          'passed',
          'released',
          'releasedAt',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /quizAttemptCounters/{counterId} {
      allow read, create, update, delete: if false;
    }

    match /quizDraftAttempts/{draftId} {
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.quizId is string;
      allow get: if signedIn() && (
        (resource != null && resource.data.studentId == request.auth.uid)
        || draftId.matches('^' + request.auth.uid + '_.*$')
      );
      allow list: if signedIn()
        && resource.data.studentId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.quizId == resource.data.quizId;
      allow delete: if signedIn()
        && resource.data.studentId == request.auth.uid;
    }

    match /students/{studentId} {
      function isRegistrationLinkStudentWrite() {
        return hasRole('student')
          && studentId == request.auth.uid
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.keys().hasAny(['registrationLinkId'])
          && request.resource.data.registrationLinkId is string
          && existsAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(request.resource.data.registrationLinkId + '_' + request.auth.uid)
          )
          && getAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(request.resource.data.registrationLinkId + '_' + request.auth.uid)
          ).data.studentAuthUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(request.resource.data.registrationLinkId + '_' + request.auth.uid)
          ).data.registrationLinkCode == request.resource.data.registrationLinkId
          && request.resource.data.assignedTutorIds.hasAny([
            getAfter(
              /databases/$(database)/documents/registrationLinkEnrollments/$(request.resource.data.registrationLinkId + '_' + request.auth.uid)
            ).data.tutorId
          ]);
      }

      allow read: if signedIn() && (
        // Permit an authenticated learner to read their canonical document path
        // even before the document exists. Registration-link claiming performs
        // transaction.get(students/{uid}) to decide between create and repair.
        studentId == request.auth.uid
        || (resource.data.keys().hasAny(['authUid']) && resource.data.authUid == request.auth.uid)
        || ownsByEmail(resource.data)
        || ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
      );

      allow create: if (
        isTutorOrAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && (request.resource.data.institutionId == currentInstitutionId() || currentInstitutionId() == null)
      ) || isRegistrationLinkStudentWrite();

      allow delete: if isAdmin() && sameInstitution(resource.data)
        || (hasRole('tutor') && resource.data.createdByUid == request.auth.uid && resource.data.registeredByRole == 'tutor');

      allow update: if canManageRecord(resource.data) || isRegistrationLinkStudentWrite() || (
        signedIn()
        && ownsByEmail(resource.data)
        && (!('authUid' in resource.data) || resource.data.authUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'emailNormalized', 'identityLinkedAt', 'updatedAt'
        ])
        && request.resource.data.authUid == request.auth.uid
      );
    }

    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isTutorOrAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || ownsByEmail(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderUid',
          'updatedAt'
        ]);
      allow delete: if isTutorOrAdmin();
    }

    match /messages/{messageId} {
      function conversationData() {
        return get(
          /databases/$(database)/documents/conversations/$(resource.data.conversationId)
        ).data;
      }

      function newConversationData() {
        return get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data;
      }

      allow read: if signedIn()
        && request.auth.uid in conversationData().participantUids;

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.auth.uid in newConversationData().participantUids
        && request.resource.data.recipientUid in newConversationData().participantUids;

      allow update: if signedIn()
        && request.auth.uid in conversationData().participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readByUids'
        ]);

      allow delete: if isTutorOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'createdByUid', 'userUid', 'title', 'body', 'type', 'priority',
          'link', 'eventKey', 'isRead', 'isPinned', 'isArchived',
          'createdAt', 'readAt', 'archivedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.type in [
          'message', 'announcement', 'assessment', 'attendance', 'result',
          'clinical', 'finance', 'academic', 'system'
        ]
        && request.resource.data.priority in ['low', 'normal', 'high', 'critical']
        && request.resource.data.isRead == false
        && request.resource.data.isPinned == false
        && request.resource.data.isArchived == false
        && (
          request.resource.data.userUid == request.auth.uid
          || isTutorOrAdmin()
          || request.resource.data.type == 'message'
        );

      allow update: if signedIn()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'readAt', 'isPinned', 'isArchived', 'archivedAt'
        ]);

      allow delete: if false;
    }

    match /notificationPreferences/{userUid} {
      allow read: if signedIn() && request.auth.uid == userUid;
      allow create, update: if signedIn()
        && request.auth.uid == userUid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['userUid', 'categories', 'updatedAt'])
        && request.resource.data.categories is map;
      allow delete: if signedIn() && request.auth.uid == userUid;
    }

    match /feeStructures/{feeStructureId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /studentInvoices/{invoiceId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || ownsByEmail(resource.data)
        || ownsLinkedStudent(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /financePayments/{paymentId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || ownsByEmail(resource.data)
        || ownsLinkedStudent(resource.data)
        || isTutorOrAdmin()
      );
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /clinicalLogbookEntries/{entryId} {
      allow create: if signedIn()
        && request.resource.data.studentAuthUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.studentAuthUid == request.auth.uid
        || isTutorOrAdmin()
      );
      allow update: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.studentAuthUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clinicalSite', 'department', 'rotationName', 'supervisorName', 'supervisorRole', 'courseUnitId',
          'courseUnitTitle', 'encounterType', 'participationLevel', 'clinicalHours', 'procedureCategory', 'procedureName',
          'procedureDate', 'patientAgeGroup', 'patientSex', 'indication',
          'outcome', 'learningOutcomes', 'reflection', 'evidenceLinks', 'status', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow delete: if isTutorOrAdmin() || (
        signedIn()
        && resource.data.studentAuthUid == request.auth.uid
        && resource.data.status == 'draft'
      );
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /timetableEntries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isTutorOrAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        ownsByUid(resource.data)
        || ownsLinkedStudent(resource.data)
        || isTutorOrAdmin()
      );

      allow create, delete: if isTutorOrAdmin();

      allow update: if isTutorOrAdmin() || (
        signedIn()
        && (ownsLinkedStudent(resource.data) || ownsByUid(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'studentAuthUid', 'userId', 'studentEmailNormalized',
          'identityLinkedAt', 'startedModules', 'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['studentAuthUid']) || request.resource.data.studentAuthUid == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid)
      );
    }

    match /contactRequests/{requestId} {
      allow create: if
        request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'public-website';
      allow read, update, delete: if isAdmin();
    }

    match /aiUsageLogs/{logId} {
      allow read: if isTutorOrAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /registrationLinks/{linkCode} {
      function studentClaimEnrollmentId() {
        return linkCode + '_' + request.auth.uid;
      }

      function isValidStudentClaimIncrement() {
        return hasRole('student')
          && resource.data.keys().hasAny(['registrationCount'])
          && request.resource.data.registrationCount == resource.data.registrationCount + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'registrationCount', 'updatedAt'
          ])
          && existsAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(studentClaimEnrollmentId())
          )
          && getAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(studentClaimEnrollmentId())
          ).data.studentAuthUid == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/registrationLinkEnrollments/$(studentClaimEnrollmentId())
          ).data.registrationLinkCode == linkCode;
      }

      allow read: if resource.data.status == 'active' || (
        signedIn() && (
          (resource.data.keys().hasAny(['createdByUid']) && resource.data.createdByUid == request.auth.uid)
          || isAdmin()
        )
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.code == linkCode
        && request.resource.data.status == 'active';
      allow update: if signedIn() && (
        (resource.data.keys().hasAny(['createdByUid']) && resource.data.createdByUid == request.auth.uid)
        || (isAdmin() && sameInstitution(resource.data))
        || isValidStudentClaimIncrement()
      );
      allow delete: if false;
    }

    match /registrationLinkEnrollments/{enrollmentId} {
      function enrollmentBelongsToCurrentStudent() {
        return signedIn()
          && enrollmentId == resource.data.registrationLinkCode + '_' + request.auth.uid
          && resource.data.studentAuthUid == request.auth.uid;
      }

      function requestedEnrollmentBelongsToCurrentStudent() {
        return hasRole('student')
          && enrollmentId == request.resource.data.registrationLinkCode + '_' + request.auth.uid
          && request.resource.data.studentAuthUid == request.auth.uid;
      }

      allow create: if requestedEnrollmentBelongsToCurrentStudent()
        && request.resource.data.registrationLinkCode is string
        && exists(/databases/$(database)/documents/registrationLinks/$(request.resource.data.registrationLinkCode))
        && get(/databases/$(database)/documents/registrationLinks/$(request.resource.data.registrationLinkCode)).data.status == 'active';

      // The claim transaction performs a get before creating the deterministic
      // {linkCode}_{studentUid} document. Permit only that student's exact ID.
      allow get: if signedIn() && (
        enrollmentId.matches('^.*_' + request.auth.uid + '$')
        || enrollmentBelongsToCurrentStudent()
        || (resource.data.keys().hasAny(['tutorId']) && resource.data.tutorId == request.auth.uid)
        || (isAdmin() && sameInstitution(resource.data))
      );

      allow list: if signedIn() && (
        (resource.data.keys().hasAny(['studentAuthUid']) && resource.data.studentAuthUid == request.auth.uid)
        || (resource.data.keys().hasAny(['tutorId']) && resource.data.tutorId == request.auth.uid)
        || (isAdmin() && sameInstitution(resource.data))
      );

      allow update: if signedIn() && (
        (resource.data.keys().hasAny(['tutorId']) && resource.data.tutorId == request.auth.uid)
        || (isAdmin() && sameInstitution(resource.data))
      );
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      function validAuditLogCreate() {
        return signedIn()
          && request.resource.data.keys().hasOnly([
            'action', 'actorUid', 'actorRole', 'institutionId', 'resourceType',
            'resourceId', 'summary', 'metadata', 'createdAt'
          ])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == userDocument().data.role
          && request.resource.data.actorRole in ['student', 'tutor', 'admin']
          && request.resource.data.action in [
            'clinical_logbook.create',
            'clinical_logbook.update',
            'clinical_logbook.review',
            'examination.create',
            'examination.update',
            'examination.delete',
            'examination.version_create'
          ]
          && request.resource.data.resourceType in [
            'clinicalLogbookEntry', 'examination'
          ]
          && request.resource.data.resourceId is string
          && request.resource.data.resourceId.size() > 0
          && request.resource.data.resourceId.size() <= 160
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 500
          && request.resource.data.metadata is map
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.institutionId == null
            || request.resource.data.institutionId == currentInstitutionId()
          );
      }

      allow read: if isPlatformAdmin() || (isAdmin() && (
        resource.data.institutionId == null
        || sameInstitution(resource.data)
      ));
      allow create: if isPlatformAdmin() || validAuditLogCreate();
      allow update, delete: if false;
    }

    // Academic catalogue and assessment definitions.
    match /programmes/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (hasRole('student') && hasProgrammeAssignment(documentId))
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.assignedTutorIds
        && validCreateInstitution(request.resource.data);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /courses/{documentId} {
      allow read: if (
        resource.data.keys().hasAny(['published'])
        && resource.data.published == true
      ) || (signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (hasRole('student') && canReadCourseRecord(documentId, resource.data))
        || (resource.data.keys().hasAny(['programmeId']) && resource.data.programmeId != null && canReadProgramme(resource.data.programmeId))
        || (
          hasRole('student')
          && resource.data.keys().hasAny(['isPublished'])
          && resource.data.isPublished == true
          && resource.data.keys().hasAny(['courseUnitId'])
          && resource.data.courseUnitId != null
          && hasCourseUnitAssignment(resource.data.courseUnitId)
        )
      ));
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.assignedTutorIds
        && request.resource.data.institutionId == currentInstitutionId()
        && canReadProgramme(request.resource.data.programmeId);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /courseUnits/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (hasRole('student') && canReadCourseRecord(documentId, resource.data))
        || (resource.data.keys().hasAny(['programmeId']) && resource.data.programmeId != null && canReadProgramme(resource.data.programmeId))
      );
      allow create: if isTutorOrAdmin() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if canManageRecord(resource.data);
    }

    match /modules/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (resource.data.keys().hasAny(['programmeId']) && resource.data.programmeId != null && canReadProgramme(resource.data.programmeId))
        || (hasRole('student') && resource.data.keys().hasAny(['courseUnitId']) && resource.data.courseUnitId != null && hasCourseUnitAssignment(resource.data.courseUnitId))
        || (hasRole('student') && resource.data.keys().hasAny(['courseId']) && resource.data.courseId != null && hasCourseUnitAssignment(resource.data.courseId))
      );
      allow create: if isTutorOrAdmin() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if canManageRecord(resource.data);
    }

    function canStudentReadLesson(data) {
      return hasRole('student') && (
        (
          data.keys().hasAny(['courseUnitId'])
          && data.courseUnitId != null
          && hasCourseUnitAssignment(data.courseUnitId)
        )
        || (
          data.keys().hasAny(['courseId'])
          && data.courseId != null
          && hasCourseUnitAssignment(data.courseId)
        )
        || (
          data.keys().hasAny(['moduleId'])
          && data.moduleId is string
          && exists(/databases/$(database)/documents/modules/$(data.moduleId))
          && (
            (
              get(/databases/$(database)/documents/modules/$(data.moduleId)).data.keys().hasAny(['courseUnitId'])
              && get(/databases/$(database)/documents/modules/$(data.moduleId)).data.courseUnitId != null
              && hasCourseUnitAssignment(
                get(/databases/$(database)/documents/modules/$(data.moduleId)).data.courseUnitId
              )
            )
            || (
              get(/databases/$(database)/documents/modules/$(data.moduleId)).data.keys().hasAny(['courseId'])
              && get(/databases/$(database)/documents/modules/$(data.moduleId)).data.courseId != null
              && hasCourseUnitAssignment(
                get(/databases/$(database)/documents/modules/$(data.moduleId)).data.courseId
              )
            )
          )
        )
      );
    }

    match /lessons/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || canStudentReadLesson(resource.data)
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.assignedTutorIds;
      allow update, delete: if canManageRecord(resource.data);
    }

    match /curriculumImports/{documentId} {
      allow read: if ownsRecord(resource.data) || assignedTutor(resource.data) || (isAdmin() && sameInstitution(resource.data));
      allow create: if isTutorOrAdmin()
        && request.resource.data.importedByUid == request.auth.uid
        && request.resource.data.importedByRole == userDocument().data.role
        && request.resource.data.status == 'completed';
      allow update, delete: if isAdmin() && sameInstitution(resource.data);
    }

    match /questions/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (resource.data.keys().hasAny(['programmeId']) && resource.data.programmeId != null && canReadProgramme(resource.data.programmeId))
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.assignedTutorIds
        && validCreateInstitution(request.resource.data);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /quizzes/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (
          hasRole('student')
          && resource.data.keys().hasAny(['status'])
          && resource.data.status == 'published'
          && resource.data.keys().hasAny(['courseUnitId'])
          && resource.data.courseUnitId != null
          && hasCourseUnitAssignment(resource.data.courseUnitId)
        )
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.assignedTutorIds
        && validCreateInstitution(request.resource.data);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /examinations/{documentId} {
      allow read: if signedIn() && (ownsRecord(resource.data) || assignedTutor(resource.data) || (isAdmin() && sameInstitution(resource.data)) || (hasRole('student') && resource.data.courseUnitId != null && hasCourseUnitAssignment(resource.data.courseUnitId)));
      allow create: if isTutorOrAdmin() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if canManageRecord(resource.data);
    }

    match /osceStations/{documentId} {
      allow read: if signedIn() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
        || (hasRole('student')
          && resource.data.courseUnitId != null
          && hasCourseUnitAssignment(resource.data.courseUnitId))
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && validCreateInstitution(request.resource.data);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /qualityAssuranceItems/{documentId} {
      allow read: if isTutorOrAdmin() && (
        ownsRecord(resource.data)
        || assignedTutor(resource.data)
        || (isAdmin() && sameInstitution(resource.data))
      );
      allow create: if isTutorOrAdmin()
        && request.resource.data.ownerUserId == request.auth.uid
        && validCreateInstitution(request.resource.data);
      allow update, delete: if canManageRecord(resource.data);
    }

    match /donations/{documentId} {
      allow read: if signedIn() && (
        resource.data.donorUid == request.auth.uid
        || isAdmin()
      );
      // Donation records are created and verified only by trusted Cloud Functions.
      allow create, update, delete: if false;
    }


    // RC3 Platform Layer. These collections are additive and intentionally
    // isolated from the stable institution-scoped academic LMS collections.
    match /tenants/{tenantId} {
      allow read: if isPlatformAdmin() || hasTenantMembership(tenantId);
      allow create, update, delete: if isPlatformAdmin();
    }
    match /tenantMemberships/{membershipId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.tenantId is string && canManageTenant(resource.data.tenantId));
      allow create, update, delete: if isPlatformAdmin();
    }
    match /plans/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isPlatformAdmin();
    }
    match /featureFlags/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /supportTickets/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /platformAnnouncements/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /platformUsage/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /roadmapItems/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /roadmapVotes/{documentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }
    match /licenseGrants/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }
    match /platformSettings/{documentId} {
      allow read, create, update, delete: if isPlatformAdmin();
    }

    // RC4 Finance Domain. Reads are limited to platform administrators.
    // All financial writes are trusted-server only to preserve ledger integrity.
    match /financePlans/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /subscriptions/{documentId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.keys().hasAny(['tenantId']) && hasTenantMembership(resource.data.tenantId));
      allow create, update, delete: if false;
    }
    match /wallets/{documentId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /ledgerAccounts/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /journals/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /ledgerEntries/{documentId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /accountingPeriods/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /invoices/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /payments/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /coupons/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /commissionRules/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /withdrawals/{documentId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /financeEvents/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /financeCommands/{documentId} { allow read, create, update, delete: if false; }

    // Server-maintained abuse-prevention and webhook idempotency records.
    match /functionRateLimits/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /webhookReceipts/{documentId} {
      allow read, create, update, delete: if false;
    }



    // RC5 Marketplace Foundation. Published catalogue records are public.
    // Sellers may manage only their own draft/submitted records; publication is platform-controlled.
    match /marketplaceProducts/{productId} {
      allow read: if resource.data.status == 'published'
        || isPlatformAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if signedIn()
        && (hasRole('tutor') || isAdmin())
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted'];
      allow update: if isPlatformAdmin() || (
        signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow delete: if isPlatformAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid && resource.data.status == 'draft');
    }
    match /sellerProfiles/{sellerId} {
      allow read: if resource.data.status == 'active' || isPlatformAdmin() || (signedIn() && sellerId == request.auth.uid);
      allow create, update: if isPlatformAdmin() || (signedIn() && sellerId == request.auth.uid && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isPlatformAdmin();
    }
    match /marketplaceCategories/{categoryId} {
      allow read: if resource.data.active == true || isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }
    match /productMedia/{mediaId} {
      allow read: if resource.data.public == true || isPlatformAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isPlatformAdmin() || (signedIn() && request.resource.data.sellerId == request.auth.uid);
      allow update: if isPlatformAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid && request.resource.data.sellerId == resource.data.sellerId);
      allow delete: if isPlatformAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
    }
    match /productTags/{tagId} { allow read: if true; allow create, update, delete: if isPlatformAdmin(); }
    match /productEntitlements/{entitlementId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /marketplaceCarts/{customerUid} {
      allow read, create, update, delete: if signedIn()
        && customerUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['customerUid']) || request.resource.data.customerUid == request.auth.uid);
    }
    match /marketplaceWishlists/{customerUid} {
      allow read, create, update, delete: if signedIn()
        && customerUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['customerUid']) || request.resource.data.customerUid == request.auth.uid);
    }
    match /marketplacePurchases/{purchaseId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid) || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /marketplaceEnrollments/{enrollmentId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // RC5 Final marketplace intelligence and operations.
    match /productReviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isPlatformAdmin() || (signedIn() && resource.data.reviewerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /productReviewVotes/{voteId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.voterUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /productRatingSummaries/{productId} { allow read: if true; allow create, update, delete: if false; }
    match /recentlyViewed/{viewId} {
      allow read, delete: if signedIn() && resource.data.customerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.customerUid == request.auth.uid && request.resource.data.customerUid == request.auth.uid;
    }
    match /sellerAnalytics/{snapshotId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /buyerAnalytics/{snapshotId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /recommendations/{recommendationId} {
      allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /trendingProducts/{documentId} { allow read: if true; allow create, update, delete: if false; }
    match /marketplacePromotions/{documentId} { allow read: if resource.data.status == 'active' || isPlatformAdmin(); allow create, update, delete: if false; }
    match /marketplaceCoupons/{documentId} { allow read: if resource.data.status == 'active' || isPlatformAdmin(); allow create, update, delete: if false; }
    match /couponRedemptions/{documentId} { allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid); allow create, update, delete: if false; }
    match /sellerVerifications/{sellerId} { allow read: if resource.data.status == 'verified' || isPlatformAdmin() || (signedIn() && sellerId == request.auth.uid); allow create, update, delete: if false; }
    match /marketplaceModeration/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /fraudSignals/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /marketingCampaigns/{documentId} { allow read: if isPlatformAdmin(); allow create, update, delete: if false; }
    match /featuredContent/{documentId} { allow read: if resource.data.active == true || isPlatformAdmin(); allow create, update, delete: if false; }

    // Secure default: collections not explicitly listed above are inaccessible.

    match /academicYears/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /semesters/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /departments/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /institutionSettings/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /powerpointPreviews/{previewId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }


    // RC4 Batch 3 commerce records. Trusted Functions own all writes.
    match /commerceOrders/{documentId} { allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid); allow create, update, delete: if false; }
    match /commerceProducts/{documentId} { allow read: if resource.data.status == 'published' || isPlatformAdmin(); allow create, update, delete: if false; }
    match /commerceEntitlements/{documentId} { allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid); allow create, update, delete: if false; }
    match /receipts/{documentId} { allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid); allow create, update, delete: if false; }
    match /refunds/{documentId} { allow read: if isPlatformAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid); allow create, update, delete: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
